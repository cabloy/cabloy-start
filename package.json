{
  "name": "cabloy-start",
  "private": "true",
  "description": "A Node.js fullstack framework",
  "keywords": [
    "cabloy",
    "fullstack",
    "vona",
    "zova"
  ],
  "homepage": "https://github.com/cabloy/cabloy#readme",
  "bugs": {
    "url": "https://github.com/cabloy/cabloy/issues"
  },
  "license": "MIT",
  "author": "zhennann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cabloy/cabloy.git"
  },
  "type": "module",
  "scripts": {
    "init": "node scripts/init.ts",
    "init:test-data": "node scripts/initTestData.ts",
    "upgrade": "node scripts/upgrade.ts",
    "upgrade:dry-run": "node scripts/upgrade.ts --dry-run",
    "vona": "node ./vona/packages-cli/cli/src/bin/vona.ts --projectPath=vona",
    "zova": "node ./zova/packages-cli/cli/src/bin/zova.ts --projectPath=zova",
    "dev": "cd vona && npm run dev",
    "dev:one": "cd vona && npm run dev:one",
    "dev:zova:admin": "cd zova && npm run dev:ssr:cabloyStartAdmin",
    "dev:zova:web": "cd zova && npm run dev:ssr:cabloyStartWeb",
    "build": "npm run build:zova && pnpm --dir vona run build",
    "build:docker": "npm run build:zova && pnpm --dir vona run build:docker",
    "build:zova:all": "npm run build:zova",
    "build:zova": "pnpm --dir zova run build:ssr:cabloyStartBatch",
    "build:zova:admin": "pnpm --dir zova run build:ssr:cabloyStartAdmin && pnpm --dir zova run build:rest:cabloyStartAdmin",
    "build:zova:web": "pnpm --dir zova run build:ssr:cabloyStartWeb && pnpm --dir zova run build:rest:cabloyStartWeb",
    "start": "cd vona && npm run start",
    "start:one": "cd vona && npm run start:one",
    "test": "cd vona && npm run test",
    "db:reset": "cd vona && npm run db:reset",
    "tsc": "npm run tsc:zova && pnpm --dir vona run tsc",
    "tsc:zova": "pnpm --dir zova run tsc",
    "deps:vona": "pnpm --dir vona run vona :tools:deps",
    "deps:zova": "pnpm --dir zova run zova :tools:deps",
    "test:e2e:start": "playwright test --config e2e/config/playwright.start.config.ts",
    "test:e2e:start:web": "playwright test --config e2e/config/playwright.start.config.ts --grep @web",
    "test:e2e:start:admin": "playwright test --config e2e/config/playwright.start.config.ts --grep @admin",
    "test:e2e:start:clean": "node e2e/scripts/testE2eClean.ts start",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cabloy/dotenv": "^1.2.8",
    "@cabloy/lint": "^5.1.31",
    "@cabloy/process-helper": "^3.1.3",
    "@playwright/test": "^1.62.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "minimist": "^1.2.8",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tar": "^7.5.22",
    "textlint": "^15.7.0",
    "textlint-rule-en-no-mixed-period": "^3.0.2",
    "textlint-rule-ja-no-mixed-period": "^3.0.2",
    "textlint-rule-ja-space-between-half-and-full-width": "^2.4.2",
    "textlint-rule-period-in-list-item": "^1.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.4.0"
  },
  "packageManager": "pnpm@11.5.2"
}
